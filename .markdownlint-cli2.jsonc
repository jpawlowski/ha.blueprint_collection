{
  // Extra files linted beyond the globs passed by script/markdown
  // (*.md, docs/**/*.md, .github/**/*.md). The agent skills live in
  // .agents/skills/, which those globs do not reach.
  "globs": [".agents/skills/**/*.md"],

  // Files and directories excluded from markdownlint validation.
  // Keep in sync with .prettierignore — markdownlint-cli2 does NOT support .markdownlintignore.
  "ignores": [
    // Runtime / generated directories
    "node_modules/**",
    "config/**",
    ".local/**",
    // Claude Code's symlink to .agents/skills/. The same files are already
    // linted through their real path above; linting them twice reports every
    // finding twice and lets the two paths disagree.
    ".claude/skills/**",
    // Third-party files vendored verbatim from upstream repositories. They must
    // stay byte-identical to their pinned commit (script/skills-sync --check),
    // so a lint fix here would break the sync rather than improve anything.
    ".agents/skills/*/vendor/**",
    // Auto-generated release file
    "CHANGELOG.md"
  ]
}
