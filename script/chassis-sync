#!/bin/bash

# script/chassis-sync: Sync shared development chassis files from the upstream template
#
# The development environment (DevContainer, agent runtime, generic scripts and
# linter configuration) is maintained in the upstream integration blueprint:
#
#   https://github.com/jpawlowski/hacs.integration_blueprint
#
# That repository is leading for those files; this repository owns everything
# blueprint-specific. The exact file list lives in .github/chassis-manifest.txt
# as an explicit allowlist — see that file for the rules.
#
# Usage:
#   ./script/chassis-sync [--check] [--ref REF]
#
# Options:
#   --check      Report drift and exit non-zero; do not modify any file
#   --ref REF    Upstream branch, tag, or commit to sync from (default: main)
#
# Examples:
#   ./script/chassis-sync --check     # Is anything out of date?
#   ./script/chassis-sync             # Apply upstream changes to the working tree
#
# Environment:
#   CHASSIS_UPSTREAM      Override the upstream repository (owner/repo or URL)
#   CHASSIS_LOCAL_SOURCE  Use an existing local checkout instead of cloning
#                         (useful when both repositories are checked out side by side)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

MANIFEST=".github/chassis-manifest.txt"
UPSTREAM="${CHASSIS_UPSTREAM:-jpawlowski/hacs.integration_blueprint}"
REF="main"
CHECK_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
    --check)
        CHECK_ONLY=true
        shift
        ;;
    --ref)
        REF="$2"
        shift 2
        ;;
    *)
        log_error "Unknown option: $1"
        echo "Usage: script/chassis-sync [--check] [--ref REF]"
        exit 1
        ;;
    esac
done

if [[ ! -f "$MANIFEST" ]]; then
    die "Chassis manifest not found: $MANIFEST"
fi

run_hook "chassis-sync" "pre"

# ── Obtain the upstream tree ─────────────────────────────────────────────────
CLONE_DIR=""
# Must always succeed: this runs as the EXIT trap, and a non-zero status here
# would leak into the script's own exit code.
# shellcheck disable=SC2317  # invoked indirectly via trap
cleanup() {
    if [[ -n "$CLONE_DIR" && -d "$CLONE_DIR" ]]; then
        rm -rf "$CLONE_DIR"
    fi
    return 0
}
trap cleanup EXIT

if [[ -n "${CHASSIS_LOCAL_SOURCE:-}" ]]; then
    SOURCE_DIR="$CHASSIS_LOCAL_SOURCE"
    [[ -d "$SOURCE_DIR" ]] || die "CHASSIS_LOCAL_SOURCE is not a directory: $SOURCE_DIR"
    log_header "Comparing against local checkout"
    log_info "Source: $SOURCE_DIR"
else
    if [[ "$UPSTREAM" == http*://* || "$UPSTREAM" == git@* ]]; then
        UPSTREAM_URL="$UPSTREAM"
    else
        UPSTREAM_URL="https://github.com/${UPSTREAM}.git"
    fi
    log_header "Fetching chassis from upstream"
    log_info "Upstream: ${UPSTREAM_URL} (${REF})"
    CLONE_DIR=$(mktemp -d)
    SOURCE_DIR="$CLONE_DIR"
    git clone --quiet --depth 1 --branch "$REF" "$UPSTREAM_URL" "$CLONE_DIR" ||
        die "Failed to clone ${UPSTREAM_URL} at ref ${REF}"
fi

# ── Compare and copy ─────────────────────────────────────────────────────────
log_header "Checking chassis files"

changed=0
missing=0
unchanged=0

while IFS= read -r entry || [[ -n "$entry" ]]; do
    # Strip comments and whitespace
    entry="${entry%%#*}"
    entry="$(echo "$entry" | xargs 2>/dev/null || true)"
    [[ -n "$entry" ]] || continue

    src="$SOURCE_DIR/$entry"

    if [[ ! -f "$src" ]]; then
        log_result 1 "Missing upstream: $entry"
        missing=$((missing + 1))
        continue
    fi

    if [[ -f "$entry" ]] && cmp -s "$entry" "$src"; then
        unchanged=$((unchanged + 1))
        continue
    fi

    changed=$((changed + 1))
    if [[ "$CHECK_ONLY" == true ]]; then
        log_result 1 "Out of date: $entry"
    else
        mkdir -p "$(dirname "$entry")"
        cp "$src" "$entry"
        log_result 0 "Updated: $entry"
    fi
done <"$MANIFEST"

echo ""
log_info "In sync: $unchanged | Differing: $changed | Missing upstream: $missing"

# A manifest entry that no longer exists upstream is always an error: the file
# was renamed or removed there, so this repository is silently keeping a copy
# nobody maintains. Fix the manifest rather than ignoring it.
if [[ $missing -gt 0 ]]; then
    echo ""
    log_error "$missing manifest entry/entries no longer exist upstream"
    log_info "Remove them from $MANIFEST, or take ownership of the files in this repository"
    exit 1
fi

if [[ "$CHECK_ONLY" == true ]]; then
    if [[ $changed -gt 0 ]]; then
        echo ""
        log_error "Chassis is out of date ($changed file(s))"
        log_info "Run: ${BOLD}script/chassis-sync${NC}"
        exit 1
    fi
    log_success "Chassis is up to date"
else
    if [[ $changed -gt 0 ]]; then
        echo ""
        log_success "Updated $changed chassis file(s)"
        log_info "Review with ${BOLD}git diff${NC}, then run ${BOLD}script/check${NC} before committing"
    else
        log_success "Chassis is already up to date"
    fi
fi

run_hook "chassis-sync" "post"

# Explicit: run_hook's last evaluated expression is a failing [[ -f ]] test when
# no hook exists, which would otherwise become this script's exit status.
exit 0
